# Build-context hygiene for the root Dockerfile and tests/docker images.
# Keeps operator state, build artifacts and private key material out of
# image layers. Everything a stage needs is either generated in-image
# (certs via gen_certs.sh, agents via the builder) or COPY'd from paths
# not listed here.

target/
dist/
.git/
tests/results/
downloads/
data/
certs/*.key
*.log
