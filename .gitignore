# Pre-public-push hygiene: keep key material, runtime state, operator data
# and build artifacts out of version control.

# TLS / signing key material
certs/*.key
*.der

# Per-build and legacy server key files (ed25519 private keys, plaintext)
server_keys.json
server_keys_*.json

# Operator credentials and environment
.env
admin_creds.json

# Runtime state
data/
downloads/
dist/
*.db
nohup.out

# Build and test artifacts
target/
tests/results/

# Local build outputs and editor junk
device_helper*
summary.txt
*.swp
Dockerfile.bak*
logs/
