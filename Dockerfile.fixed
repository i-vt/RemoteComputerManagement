# ─────────────────────────────────────────────────────────────────────────────
# RCM — Integration build: builder → unit-test (build gate) → agents → server
#
# Toolchain notes:
#  * Agents REQUIRE a nightly toolchain (builder.rs injects -Zlocation-detail=none
#    / -Ztrim-paths and refuses to build on stable unless --allow-stable-leak).
#  * The official library/rust image is STABLE-ONLY (rust:nightly-* does not
#    exist). The Rust team's nightly images live under the rustlang/ namespace.
#  * rustlang/rust selects nightly via `rustup default`; ENV RUSTUP_TOOLCHAIN
#    below is belt-and-braces alongside the patched builder's own explicit pin.
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: compile server, builder, and agent crates ──────────────────────
FROM rustlang/rust:nightly-bookworm AS build

RUN rustup component add rust-src --toolchain nightly \
 && rustc --version | grep nightly

ENV RUSTUP_TOOLCHAIN=nightly

WORKDIR /build
COPY . .

# Certs must exist BEFORE compiling: the agent crates embed
# certs/ca.crt + certs/client.crt + certs/client.key.der via include_bytes!.
# gen_certs.sh is idempotent (skips if certs/ca.crt already exists; RECERT=1 forces).
RUN bash gen_certs.sh ./certs

RUN cargo build --release

# ── Stage 2: unit-test build gate (per tests/docker/README.md) ───────────────
FROM build AS unit-test
RUN cargo test --lib --tests

# ── Stage 3: agent binaries ──────────────────────────────────────────────────
FROM build AS agents

# Linux TLS agent (c2-server:4443) — the run that was failing.
RUN mkdir -p dist && \
    ./target/release/builder --host c2-server --port 4443 --transport tls \
        --platform linux --sleep 2 --jitter-min 0 --jitter-max 0 --debug && \
    cp dist/exe_linux_* /build/agent-tls && \
    rm -f dist/exe_linux_* && \
    echo "[+] TLS agent built"

# Linux HTTP agent (c2-server:4480) — agent-2 in the compose stack.
RUN ./target/release/builder --host c2-server --port 4480 --transport http \
        --platform linux --sleep 2 --jitter-min 0 --jitter-max 0 --debug && \
    cp dist/exe_linux_* /build/agent-http && \
    rm -f dist/exe_linux_* && \
    echo "[+] HTTP agent built"

# Hibernation agent (server-entrypoint.sh expects /opt/rcm/agent-hibernation).
RUN ./target/release/builder --host c2-server --port 4443 --transport tls \
        --platform linux --sleep 60 --jitter-min 10 --jitter-max 20 \
        --hibernation --batch-size 10 && \
    cp dist/exe_linux_* /build/agent-hibernation && \
    rm -f dist/exe_linux_* && \
    echo "[+] Hibernation agent built"

# ── Stage 4: server runtime image ────────────────────────────────────────────
FROM debian:bookworm-slim AS server

# server-entrypoint.sh needs python3 (sqlite cleanup, JSON parsing) and curl
# (API readiness probe); ca-certificates for any TLS egress.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/rcm

# Server binary + runtime assets (certs are read from disk on first run and
# seeded into c2_audit.db; the DB ships in the image per the entrypoint).
COPY --from=build /build/target/release/server ./server
COPY --from=build /build/certs ./certs
COPY --from=build /build/c2_audit.db ./c2_audit.db
COPY --from=build /build/extensions ./extensions
COPY --from=build /build/modules ./modules

# Pre-built agents land where server-entrypoint.sh looks for them.
COPY --from=agents /build/agent-tls /build/agent-http /build/agent-hibernation ./

COPY tests/docker/scripts/server-entrypoint.sh /server-entrypoint.sh
RUN chmod +x /server-entrypoint.sh

EXPOSE 8080 4443 4480

ENTRYPOINT ["/server-entrypoint.sh"]
